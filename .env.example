# DisasterSim AI - Environment Variables Template
# Copy this file to .env and customize as needed:
# cp .env.example .env

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# PostgreSQL Connection URL
# Local PostgreSQL default:
DATABASE_URL=jdbc:postgresql://localhost:5432/disastersimdb

# Or Supabase / Cloud PostgreSQL:
# DATABASE_URL=jdbc:postgresql://<host>:5432/<database>?sslmode=require

DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# ==============================================================================
# SECURITY & AUTHENTICATION
# ==============================================================================
# 256-bit or 384-bit Hex/Base64 Secret Key for JWT Signing
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# ==============================================================================
# AI ENGINE CONFIGURATION (Optional)
# ==============================================================================
# Google Gemini API Key for dynamic multi-modal post-drill debriefing
# If left empty, DisasterSim AI uses built-in heuristic evaluation and scoring.
GEMINI_API_KEY=
